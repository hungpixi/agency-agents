# Per-project Dokploy deployment config. Do not put DOKPLOY_API_KEY here.
# Global operator credentials should live in:
# C:/Users/ppnh1/.codex/secrets/dokploy.env

DOKPLOY_PROJECT_NAME=<project-name>
DOKPLOY_ENVIRONMENT_NAME=production
DOKPLOY_DEPLOY_MODE=custom-git

# For custom-git mode
DOKPLOY_GIT_URL=https://github.com/hungpixi/<repo>.git
DOKPLOY_BRANCH=main
DOKPLOY_BUILD_PATH=/
DOKPLOY_DOCKERFILE=Dockerfile
DOKPLOY_DOCKER_CONTEXT_PATH=/

# For docker-image mode
DOKPLOY_DOCKER_IMAGE=ghcr.io/hungpixi/<image>:latest
DOKPLOY_DOCKER_REGISTRY_URL=https://ghcr.io
DOKPLOY_DOCKER_REGISTRY_USERNAME=hungpixi
DOKPLOY_DOCKER_REGISTRY_PASSWORD=<github-pat-or-empty-if-public>

# Optional web domain
DOKPLOY_DOMAIN=
DOKPLOY_PORT=3000
DOKPLOY_HTTPS=true

# Optional managed databases
DOKPLOY_CREATE_POSTGRES=false
DOKPLOY_POSTGRES_NAME=<project>-postgres
DOKPLOY_POSTGRES_DATABASE=<project>
DOKPLOY_POSTGRES_USER=<project>
DOKPLOY_POSTGRES_PASSWORD=<generate-password>

DOKPLOY_CREATE_REDIS=false
DOKPLOY_REDIS_NAME=<project>-redis
DOKPLOY_REDIS_PASSWORD=<generate-password>

# Optional mounts. Keep empty unless needed.
# Format idea for client: name:/container/path,type=volume;cache:/cache,type=volume
DOKPLOY_MOUNTS=

# Runtime env vars to inject into the application.
# Use KEY=value lines in project-specific deploy/dokploy.app.env, not here.
DOKPLOY_APP_ENV_FILE=deploy/dokploy.app.env
