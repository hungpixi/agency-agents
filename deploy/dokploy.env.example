# Agency Agents OPC - Dokploy automation + runtime environment template
# Copy this file to deploy/dokploy.env, fill real values, and keep that real file private.

# Dokploy API automation
DOKPLOY_BASE_URL=https://dp.sgp1.w9.nu
DOKPLOY_API_KEY=<dokploy-api-key>
DOKPLOY_PROJECT_NAME=agency-agents-opc
DOKPLOY_ENVIRONMENT_NAME=production
DOKPLOY_DESCRIPTION=Agency Agents OPC 24x7 runtime

# Domains. Leave runtime domain empty unless you explicitly want to expose it.
AGENCY_API_DOMAIN=<agency-api.your-domain.com>
AGENCY_RUNTIME_DOMAIN=

# Docker/Git source for the project we will create in this repo.
# After I add the runtime files, this should point to the repo/fork Dokploy can pull.
AGENCY_DEPLOY_REPOSITORY=<github-owner-or-org>/<repo-name>
AGENCY_DEPLOY_BRANCH=main
AGENCY_DEPLOY_PROVIDER=github
AGENCY_CATALOG_DOCKERFILE=deploy/agency-catalog/Dockerfile
AGENCY_API_DOCKERFILE=apps/control-plane/Dockerfile
AGENCY_RUNTIME_DOCKERFILE=deploy/agency-runtime/Dockerfile

# Optional pre-created Dokploy server id. Leave empty to let the automation use default.
DOKPLOY_SERVER_ID=

# Catalog sync
AGENCY_REPO=https://github.com/msitarzewski/agency-agents.git
AGENCY_BRANCH=main
AGENCY_RUNTIME=openclaw
AGENCY_SYNC_INTERVAL_SECONDS=3600

# Runtime
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=<generate-random-32-byte-token>

# Control plane
CONTROL_PLANE_TOKEN=<generate-random-32-byte-token>
AGENCY_PUBLIC_API_URL=https://<your-agency-api-domain>
AGENCY_MAX_PARALLEL_JOBS=1
AGENCY_MAX_TOKENS_PER_JOB=250000
AGENCY_DAILY_JOB_LIMIT=20
AGENCY_DAILY_TOKEN_LIMIT=2000000

# Storage paths inside containers
AGENCY_CATALOG_DIR=/data/agency
AGENCY_RUNTIME_DIR=/data/runtime
AGENCY_JOBS_DIR=/data/jobs

# Databases
REDIS_PASSWORD=<generated-by-bootstrap>
POSTGRES_PASSWORD=<generated-by-bootstrap>
REDIS_URL=redis://<redis-host>:6379/0
DATABASE_URL=postgresql://<postgres-user>:<postgres-password>@<postgres-host>:5432/<postgres-db>

# LLM provider keys. Fill only the providers you want enabled.
OPENAI_API_KEY=<optional-openai-api-key>
ANTHROPIC_API_KEY=<optional-anthropic-api-key>
GOOGLE_GENERATIVE_AI_API_KEY=<optional-google-api-key>
OPENROUTER_API_KEY=<optional-openrouter-api-key>

# GitHub access. Public repo sync does not require this, but it helps with rate limits
# and future private fork workflows.
GITHUB_TOKEN=<optional-github-token>

# Operations
LOG_LEVEL=info
NODE_ENV=production
TZ=Asia/Saigon
