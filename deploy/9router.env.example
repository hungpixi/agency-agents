# 9Router runtime env for Dokploy.
# Copy to deploy/9router.env locally or let scripts/dokploy/apply-9router.mjs create it.
# Do not commit the real deploy/9router.env file.

# Optional public URL. Leave blank until DNS points to the Dokploy server.
NINE_ROUTER_PUBLIC_URL=

# Required by 9Router. The apply script generates strong values locally.
JWT_SECRET=<generate-random-secret>
INITIAL_PASSWORD=<generate-random-password>
API_KEY_SECRET=<generate-random-secret>
MACHINE_ID_SALT=<generate-random-secret>

# Docker runtime contract from https://github.com/decolua/9router.
DATA_DIR=/app/data
PORT=20128
HOSTNAME=0.0.0.0
NODE_ENV=production

# Cloud sync/public URLs. Set BASE_URL and NEXT_PUBLIC_BASE_URL to the public URL once attached.
BASE_URL=
NEXT_PUBLIC_BASE_URL=
CLOUD_URL=https://9router.com
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Ops/security defaults.
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Optional backup restore. The apply script fills this from 9router-backup-*.json locally.
NINE_ROUTER_DB_JSON_BASE64=<base64-db-json>
NINE_ROUTER_DB_JSON_SHA256=<sha256-of-db-json>
NINE_ROUTER_RESTORE_BACKUP=true
NINE_ROUTER_FORCE_RESTORE=false
